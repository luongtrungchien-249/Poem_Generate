# Multi-stage build: ảnh chạy chỉ chứa gói đã cài, không chứa toolchain biên dịch
FROM python:3.11-slim AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir ".[api]"

FROM python:3.11-slim AS runner

WORKDIR /app
RUN useradd --create-home --uid 10001 appuser
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Chỉ cấu hình cần đi kèm; mã nguồn đã nằm trong site-packages
COPY configs ./configs

USER appuser
EXPOSE 8000
ENV PYTHONUNBUFFERED=1 ENV=production

CMD ["uvicorn", "ai_platform.entrypoints.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
