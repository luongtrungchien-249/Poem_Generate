# ============================================================
# AI Platform — mẫu biến môi trường
# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
# Cấu hình không bí mật nằm ở configs/*.yaml, không nằm ở đây.
# ============================================================

# Môi trường: dev | staging | production
ENV=dev

# Máy chủ (ghi đè configs/<env>.yaml nếu đặt)
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Nhà cung cấp mô hình: openai | anthropic | google | vllm | mock
#
# Dùng Gemini làm mặc định:  DEFAULT_PROVIDER=google  DEFAULT_MODEL=gemini-3.5-flash-lite
# (chat tự chọn model Gemini theo `tiers_theo_provider` trong configs/models.yaml).
#
# NHIỀU KHOÁ CÙNG LÚC: điền cả OPENAI_API_KEY lẫn GOOGLE_API_KEY thì mỗi model đi
# đúng nhà cung cấp theo tên — gemini-* -> Google, gpt-* -> OpenAI, claude-* ->
# Anthropic (adapters/llm/theo_model.py). DEFAULT_PROVIDER chỉ quyết định model
# mặc định và provider nào dùng khi tên model không nhận ra được.
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TIER=cheap

# --- Bí mật ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VLLM_BASE_URL=http://localhost:8000/v1

# --- Hạ tầng (để trống = dùng adapter in-memory) ---
DATABASE_URL=
REDIS_URL=
QDRANT_URL=

# --- Guardrails & giới hạn ---
ENABLE_GUARDRAILS=true
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_RATE=5.0
